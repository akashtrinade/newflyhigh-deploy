# ── Signaling Server — Environment Variables ──
# Helmet security headers (CSP, HSTS, X-Frame-Options, etc.) are auto-configured in server.js.
# CSP connect-src allows CORS_ORIGINS; no additional env vars needed for helmet.

# ── Server ──
PORT=5000

# ── JWT Authentication (REQUIRED for production) ──
# Base64-encoded HMAC-SHA256 key. Must match the backend JWT secret.
# Generate: openssl rand -base64 32
JWT_SECRET=

# ── CORS ──
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Lambda/DynamoDB (production only) ──
# CONNECTIONS_TABLE=flyhigh-connections
# ROOMS_TABLE=flyhigh-rooms
# AWS_REGION=us-east-1
